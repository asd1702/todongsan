# EC2 Docker Compose environment example.
# Copy this file to .env on EC2.
# Do not commit real secrets.
# Do not put RDS endpoints, EC2 public IPs, or production credentials here.

# Database for service-owned Docker MySQL instances on the same EC2
DB_MEMBERPOINT=memberpoint
DB_BATTLE=battle
DB_MARKET=market
DB_INSIGHT=insight
MEMBERPOINT_DB_USERNAME=memberpoint_user
MEMBERPOINT_DB_PASSWORD=change-me
MARKET_DB_USERNAME=market_user
MARKET_DB_PASSWORD=change-me
BATTLE_DB_USERNAME=battle_user
BATTLE_DB_PASSWORD=change-me
INSIGHT_DB_USERNAME=insight_user
INSIGHT_DB_PASSWORD=change-me

# Auth / Security
JWT_SECRET=change-me-at-least-32-characters
CRYPTO_AES_KEY=change-me-32-byte-key
KAKAO_CLIENT_ID=change-me
INTERNAL_AUTH_TOKEN=change-me

# External APIs
REB_API_KEY=change-me
REB_API_BASE_URL=change-me

CLAUDE_API_KEY=change-me
CLAUDE_API_URL=change-me
CLAUDE_MODEL=change-me
