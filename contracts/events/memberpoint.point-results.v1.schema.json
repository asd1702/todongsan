{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todongsan/contracts/events/memberpoint.point-results.v1.schema.json",
  "title": "memberpoint.point-results v1",
  "description": "Member-Point -> Market 포인트 적립 처리 결과. 요청 이벤트 1건당 결과 이벤트 1개. Kafka key = market_id.",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producer", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "enum": ["POINT_CREDITED", "POINT_CREDIT_FAILED"] },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "member-point-service" },
    "data": {
      "type": "object",
      "required": ["requestEventId", "requestEventType", "marketId", "predictionId", "memberId", "idempotencyKey", "amount"],
      "properties": {
        "requestEventId": { "type": "string", "format": "uuid" },
        "requestEventType": {
          "type": "string",
          "enum": ["MARKET_REFUND_REQUESTED", "MARKET_SETTLEMENT_PAYOUT_REQUESTED"]
        },
        "marketId": { "type": "integer", "minimum": 1 },
        "predictionId": { "type": "integer", "minimum": 1 },
        "memberId": { "type": "integer", "minimum": 1 },
        "idempotencyKey": { "type": "string", "maxLength": 150 },
        "amount": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "status": { "type": "string", "enum": ["PROCESSED", "ALREADY_PROCESSED"] },
        "balanceSnapshot": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" },
        "errorCode": {
          "type": "string",
          "description": "알려진 값: MEMBER_NOT_FOUND, POINT_INVALID_AMOUNT, POINT_INVALID_REFERENCE_TYPE, IDEMPOTENCY_KEY_CONFLICT. 새 코드가 추가될 수 있으므로 enum으로 고정하지 않는다."
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "POINT_CREDITED" } } },
      "then": { "properties": { "data": { "required": ["status", "balanceSnapshot"] } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "POINT_CREDIT_FAILED" } } },
      "then": { "properties": { "data": { "required": ["errorCode"] } } }
    }
  ],
  "additionalProperties": true
}
